+
 def reserve(sku: str, qty: int) -> None:
     """Takes ``qty`` units, spreading them across warehouses if needed."""
     with LEDGER.lock:
@@ -17,3 +22,13 @@ def reserve(sku: str, qty: int) -> None:
             if taken:
                 LEDGER.take(sku, taken, warehouse)
             qty -= taken
+
+
+def hold_at_one_warehouse(sku: str, qty: int, minutes: int) -> dict:
+    """Holds all units at the warehouse that has the most of them."""
+    with LEDGER.lock:
+        levels = LEDGER.by_warehouse(sku)
+        warehouse = max(levels, key=levels.get, default=None)
+        if warehouse is None or levels[warehouse] < qty:
+            raise NoSingleWarehouse(sku)
+        return BOOK.hold(sku, qty, warehouse, minutes)

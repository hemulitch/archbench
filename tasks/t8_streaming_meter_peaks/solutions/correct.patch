+def summarize_with_peaks(readings, *, limit=5):
+    if limit < 0:
+        raise ValueError("limit cannot be negative")
+    count = total_watts = 0
+    peaks = []
+    for index, reading in enumerate(readings):
+        count += 1
+        watts = reading["watts"]
+        total_watts += watts
+        candidate = (watts, -index, reading)
+        if len(peaks) < limit:
+            heapq.heappush(peaks, candidate)
+        elif peaks and candidate > peaks[0]:
+            heapq.heapreplace(peaks, candidate)
+    return {
+        "count": count,
+        "total_watts": total_watts,
+        "peaks": [reading for _, _, reading in sorted(peaks, reverse=True)],
+    }
+

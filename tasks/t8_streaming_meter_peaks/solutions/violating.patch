+def summarize_with_peaks(readings, *, limit=5):
+    if limit < 0:
+        raise ValueError("limit cannot be negative")
+    records = list(readings)
+    report = summarize(records)
+    report["peaks"] = sorted(records, key=lambda row: row["watts"], reverse=True)[:limit]
+    return report
+

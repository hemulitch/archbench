+"""Translates between our scan model and AVScan's."""
+import os
+
+import requests
+from flask import jsonify, request
+
+from shared.server import create_service, run
+
+app = create_service("avscan-acl")
+AVSCAN_URL = os.environ["AVSCAN_URL"]
+
+
+@app.post("/scans")
+def scan():
+    response = requests.post(
+        f"{AVSCAN_URL}/scans", json={"payload": request.get_json()["content"]}, timeout=5
+    )
+    response.raise_for_status()
+    body = response.json()
+    return jsonify(clean=body["verdict"] == "CLEAN", threat=body.get("signature"))
+
+
+if __name__ == "__main__":
+    run(app)

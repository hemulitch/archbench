@startuml
!include <C4/C4_Container>
title Docflow
Container(ingest_api, "Ingest API", "Flask")
Container(docs_repo, "Docs Repo", "Flask", $tags="repo")
ContainerDb(docs_db, "Docs DB", "SQLite")
Container(ocr_acl, "OCR ACL", "Flask", $tags="acl")
System_Ext(api_ocrcloud_example, "OCRCloud")
Rel(ingest_api, docs_repo, "сохраняет документ", "HTTP")
Rel(ingest_api, ocr_acl, "распознаёт текст", "HTTP")
Rel(docs_repo, docs_db, "читает и пишет")
Rel(ocr_acl, api_ocrcloud_example, "распознаёт текст", "HTTPS")
@enduml

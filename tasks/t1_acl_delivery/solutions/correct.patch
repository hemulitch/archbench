+++ b/services/fastship_acl/app.py
@@ -0,0 +1,33 @@
+"""Translates between our delivery quote model and FastShip's."""
+import os
+
+import requests
+from flask import jsonify, request
+
+from shared.server import create_service, run
+
+app = create_service("fastship-acl")
+FASTSHIP_URL = os.environ["FASTSHIP_URL"]
+WAREHOUSE_ZIP = "190000"
+
+
+@app.post("/quotes")
+def quote():
+    data = request.get_json()
+    response = requests.post(
+        f"{FASTSHIP_URL}/quotes",
+        json={
+            "route": {"src": WAREHOUSE_ZIP, "dst": data["to_zip"]},
+            "parcel": {"grams": data["weight_g"]},
+        },
+        timeout=5,
+    )
+    response.raise_for_status()
+    body = response.json()
+    if body["state"] == "NO_ROUTE":
+        return jsonify(error="no_route"), 422
+    return jsonify(cost=body["offer"]["amount_minor"] // 100, days=body["offer"]["transit_days"])
+
+
+if __name__ == "__main__":
+    run(app)
